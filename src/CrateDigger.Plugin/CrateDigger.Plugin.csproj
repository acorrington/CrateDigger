<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CrateDigger.Plugin</RootNamespace>
    <AssemblyName>CrateDigger</AssemblyName>
    <Description>CrateDigger - AI playlist generator plugin for Emby Server.</Description>

    <!--
      Emby reference switch:
        * If the real Emby DLLs exist in ..\..\lib\  -> reference them directly (Private=false,
          they are provided by the Emby Server runtime and must NOT ship with the plugin).
        * Otherwise                                     -> compile against the CrateDigger.EmbyStubs
          project so the solution builds on machines without an Emby installation.

      To activate real references: copy MediaBrowser.Controller.dll, MediaBrowser.Model.dll and
      MediaBrowser.Common.dll from your Emby install (%AppData%\Emby-Server\system\) into lib\.
    -->
    <EmbyLibDir>$(MSBuildThisFileDirectory)..\..\lib\</EmbyLibDir>
    <UseRealEmby Condition="Exists('$(EmbyLibDir)MediaBrowser.Controller.dll') And Exists('$(EmbyLibDir)MediaBrowser.Model.dll') And Exists('$(EmbyLibDir)MediaBrowser.Common.dll')">true</UseRealEmby>
  </PropertyGroup>

  <!-- Real Emby API -->
  <ItemGroup Condition="'$(UseRealEmby)' == 'true'">
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(EmbyLibDir)MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(EmbyLibDir)MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(EmbyLibDir)MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Development stubs (no Emby install available) -->
  <ItemGroup Condition="'$(UseRealEmby)' != 'true'">
    <ProjectReference Include="..\CrateDigger.EmbyStubs\CrateDigger.EmbyStubs.csproj" />
    <CompilerVisibleProperty Include="UseRealEmby" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrateDigger.Core\CrateDigger.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Served by IHasWebPages / PluginPageInfo.EmbeddedResourcePath -->
    <EmbeddedResource Include="Resources\configPage.html" />
    <EmbeddedResource Include="Resources\configPage.js" />
    <!--
      Plugins-page thumbnail: GET /Plugins/{Id}/Thumb serves IHasThumbImage.GetThumbImage()
      (format: ImageFormat.Png). CrateDiggerPlugin streams this exact embedded resource;
      without the interface the endpoint 500s (verified NRE on live 4.10.1.0).
      LogicalName matches ThumbResourceName in CrateDiggerPlugin.cs.
    -->
    <EmbeddedResource Include="Resources\thumb.png" LogicalName="CrateDigger.Plugin.thumb.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ILRepack" Version="2.0.48">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <EmbyPluginsDir Condition="'$(EmbyPluginsDir)' == ''">$(AppData)\Emby-Server\programdata\plugins</EmbyPluginsDir>
    <IlRepackExe>$(NuGetPackageRoot)ilrepack\2.0.48\tools\ILRepack.exe</IlRepackExe>
    <IlRepackLib>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\lib'))</IlRepackLib>
  </PropertyGroup>

  <!--
    Emby loads plugin assemblies in isolated load contexts, so sibling DLLs (CrateDigger.Core.dll)
    are NOT resolvable at runtime — every first-party plugin is a single DLL for this reason.
    Merge Core into CrateDigger.dll after build so deployment is exactly one file.
  -->
  <Target Name="MergeCoreWithILRepack" AfterTargets="Build" Condition="'$(UseRealEmby)' == 'true' And Exists('$(TargetDir)CrateDigger.Core.dll') And Exists('$(IlRepackExe)')">
    <Exec Command='"$(IlRepackExe)" /internalize /lib:"$(IlRepackLib)" /out:"$(TargetDir)$(AssemblyName).merged.dll" "$(TargetPath)" "$(TargetDir)CrateDigger.Core.dll"' />
    <Move SourceFiles="$(TargetDir)$(AssemblyName).merged.dll" DestinationFiles="$(TargetPath)" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="CrateDigger: merged CrateDigger.Core into $(AssemblyName).dll (single-DLL plugin)" />
  </Target>

  <!-- Deploy only REAL (Emby-referencing, ILRepack-merged) builds — a stub build must
       never land in a live plugins folder. -->
  <Target Name="CopyPluginToEmby" AfterTargets="MergeCoreWithILRepack" Condition="'$(UseRealEmby)' == 'true' And Exists('$(EmbyPluginsDir)') And Exists('$(TargetPath)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(EmbyPluginsDir)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="CrateDigger: copied $(AssemblyName).dll to $(EmbyPluginsDir)" />
  </Target>

</Project>